# ============ Common ============
COMPOSE_PROJECT_NAME=stream-analytics

# ============ ClickHouse ============
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pass
CLICKHOUSE_DB=analytics

# ============ Generator ============
GENERATOR_INTERVAL=2
GENERATOR_BATCH_SIZE=50
GENERATOR_SEED=42
GENERATOR_ANOMALY_RATE=0.01

# ============ Superset ============
SUPERSET_SECRET_KEY=change_me_superset_secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# ============ Superset metadata Postgres ============
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset_pass
POSTGRES_DB=superset

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379

# ============ Jupyter ============
JUPYTER_PORT=8888
JUPYTER_TOKEN=devtoken
